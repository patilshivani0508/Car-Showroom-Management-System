	<parameter name="edate" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
     car_booking.`booking_id` AS car_booking_booking_id,
     car_booking.`booking_date` AS car_booking_booking_date,
     car_booking.`customer_name` AS car_booking_customer_name,
     car_booking.`customer_address` AS car_booking_customer_address,
     car_booking.`customer_city` AS car_booking_customer_city,
     car_booking.`customer_contact` AS car_booking_customer_contact,
     car_booking.`model` AS car_booking_model,
     car_booking.`car_name` AS car_booking_car_name,
     car_booking.`color` AS car_booking_color,
     car_booking.`Ex_showroom_price` AS car_booking_Ex_showroom_price,
     car_booking.`insurance` AS car_booking_insurance,
     car_booking.`registration_fee` AS car_booking_registration_fee,
     car_booking.`total_amount` AS car_booking_total_amount,
     car_booking.`customer_id` AS car_booking_customer_id,
     car_booking.`car_id` AS car_booking_car_id,
     car_booking.`advanced_amount` AS car_booking_advanced_amount,
     car_booking.`pending_amount` AS car_booking_pending_amount
FROM
     `car_booking` car_booking
where booking_date between $P{sdate} and $P{edate};]]>
	</queryString>
