	<queryString language="SQL">
		<![CDATA[SELECT
     car_details.`car_id` AS car_details_car_id,
     car_details.`model` AS car_details_model,
     car_details.`car_year` AS car_details_car_year,
     car_details.`price` AS car_details_price,
     car_details.`color` AS car_details_color,
     car_details.`mileage` AS car_details_mileage,
     car_details.`warranty` AS car_details_warranty,
     car_details.`engine_type` AS car_details_engine_type,
     car_details.`transmission` AS car_details_transmission,
     car_details.`quantity_in_stock` AS car_details_quantity_in_stock,
     car_details.`car_name` AS car_details_car_name
FROM
     `car_details` car_details]]>
	</queryString>
