	<queryString language="SQL">
		<![CDATA[SELECT
     employee_details.`emp_id` AS employee_details_emp_id,
     employee_details.`emp_name` AS employee_details_emp_name,
     employee_details.`role` AS employee_details_role,
     employee_details.`emp_gender` AS employee_details_emp_gender,
     employee_details.`emp_adhaar_no` AS employee_details_emp_adhaar_no,
     employee_details.`emp_email` AS employee_details_emp_email,
     employee_details.`emp_city` AS employee_details_emp_city,
     employee_details.`emp_address` AS employee_details_emp_address,
     employee_details.`emp_contact` AS employee_details_emp_contact,
     employee_details.`salary` AS employee_details_salary,
     employee_details.`hire_date` AS employee_details_hire_date
FROM
     `employee_details` employee_details]]>
	</queryString>
