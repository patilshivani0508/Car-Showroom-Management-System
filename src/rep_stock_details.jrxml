	<queryString>
		<![CDATA[SELECT
     stock_details.`stock_id` AS stock_details_stock_id,
     stock_details.`c_model` AS stock_details_c_model,
     stock_details.`stock_date` AS stock_details_stock_date,
     stock_details.`current_stock` AS stock_details_current_stock,
     stock_details.`car_name` AS stock_details_car_name
FROM
     `stock_details` stock_details
where `stock_date` between $P{sdate} and $P{edate};]]>
	</queryString>
