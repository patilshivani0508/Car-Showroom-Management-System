	<queryString>
		<![CDATA[SELECT
     payment.`payment_id` AS payment_payment_id,
     payment.`customer_name` AS payment_customer_name,
     payment.`customer_address` AS payment_customer_address,
     payment.`model` AS payment_model,
     payment.`color` AS payment_color,
     payment.`discount` AS payment_discount,
     payment.`discount_per` AS payment_discount_per,
     payment.`pay_date` AS payment_pay_date,
     payment.`pay_type` AS payment_pay_type,
     payment.`total_amount` AS payment_total_amount,
     payment.`car_name` AS payment_car_name
FROM
     `payment` payment
where `pay_date` between $P{sdate} and $P{edate};]]>
	</queryString>
